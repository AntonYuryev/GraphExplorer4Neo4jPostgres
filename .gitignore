node_modules/
*.log
*.lnk
*.cmd
INDEX~1.zip
public/INDEX~1.zip
github-upload.js
settings.json
users.json
GithubToken.txt
backup/

# Runtime/user-specific agent state — saved workflow snapshots under
# agent_library/ can embed a live LLM API key in their llm_config (this has
# already happened — e6800c16.json / 699a8b5d.json both contain a real
# Gemini key). Exclude everything in this directory EXCEPT user_vocabulary.json
# (deliberately shared as a starter/demo vocabulary — it only holds
# user_term/neo4j_name/neo4j_label mappings, no credentials).
# Note: use "agent_library/*" (not "agent_library/") for the exclude so git
# still recurses into the directory to honor the negation below — gitignore
# does not apply "!" exceptions to files inside a fully-excluded directory.
agent_library/*
!agent_library/user_vocabulary.json

# Personal scratch/test files that have contained live API keys in the past.
import openai.py
gemini-2.5-flash.txt

__pycache__/
*.pyc
cypher_history.tsv

# Per-user Pathway Collection Search indexes — derived/rebuildable from each
# user's own local directory (via Settings → Pathway Collection → Index),
# and can be large for a real-world collection; not application source.
pathway_indexes/

# Large test/output data — not application source, and pushes involving these
# have hit HTTP 408 timeouts (125+ MiB) over slow/proxied connections.
TestData/
Output/
Screenshots/
DatabasePowerRelease.zip
*.rnef
*.zip
