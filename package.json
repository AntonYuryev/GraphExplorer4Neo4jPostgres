{
  "name": "graph-explorer",
  "version": "2.4.0",
  "description": "Web app for exploring, visualizing, and curating Neo4j biological knowledge graphs with PostgreSQL literature references and an integrated LLM chat agent that can query, visualize, and (with confirmation) write back to the graph.",
  "main": "server.js",
  "keywords": [
    "neo4j",
    "postgresql",
    "graph-visualization",
    "cytoscape",
    "knowledge-graph",
    "llm-agent",
    "cypher",
    "biology"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/elsevier-health/psg-graphexplorer-neo4j-postgres"
  },
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "flexsearch": "^0.8.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^5.14.0",
    "pg": "^8.11.3"
  },
  "engines": {
    "node": ">=18"
  }
}
